# ============================================================
# .gitignore —— Android / iOS 双端同步用
#
# 设计原则：
#   1. 源码、文档、测试、构建脚本全部跟踪 —— 两端需要共享
#   2. 只忽略「可再生成」的产物与「版权敏感」的游戏文件
#   3. 平台专属目录不特殊处理 —— 双方从不交叉修改，天然无冲突
#
# 与旧版（仅发布源码）的区别：
#   · tests/ 与 build_variants.py 改为跟踪（测试要两端一致）
#   · dist/ 改为跟踪（产物便于对方核对，体积小）
#   · iOS/docs/ 改为跟踪（技术文档需要共享）
# ============================================================

# ---- 构建产物（可再生成）----
jni/libs/
jni/obj/
libs/
obj/
iOS/build/
*.o
*.a
build_log.txt

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- 打包输出 ----
out/
/安装包/
*.apk
*.ipa

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
desktop.ini
Thumbs.db
.DS_Store

# ---- 敏感文件（绝不入库）----
*.jks
*.keystore
*.p12
*.mobileprovision
iOS/entitlements.plist

# ---- 游戏原始文件（版权敏感）----
libPVZ2.so
*.i64
*.idb
*.so.bak


# ---- 临时 ----
*.log
*.tmp
.repack-*

# ---- 编译产物（有 .c 源码，二进制不入库）----
iOS/tools/daveconv
iOS/tools/lztgate
iOS/tools/ldcmd_add
iOS/tools/ptrfind
iOS/tools/wfind
iOS/tools/xref
iOS/tools/xref2

# ---- 备份文件 ----
*.bak
tests/.pre-*
# ---- 版本归档（入库，用于回溯与交接）----
# iOS/backup/ 下的版本快照是必需的历史记录：
#   · 每个 vXX_* 目录冻结了一次「真机验证通过」的完整源码状态
#   · v52_scanfixed/mFinal.txt 是打包必需的 22 站点清单
# 因此整个目录改为跟踪，仅排除以下体积大或敏感的内容。
!iOS/backup/

# 原始游戏二进制（版权敏感，且可由底包重新提取）
iOS/backup/PvZ2.orig
iOS/backup/PvZ2.orig.oldpkg
iOS/backup/PvZ2.*

# 开发期源码逐次快照（47 个同源文件，体积 6.8M，价值低于版本归档）
iOS/backup/src/

# 用户数据备份（个人存档，不入库）
iOS/backup/No_Backup-backup.tar
iOS/backup/No_Backup-*.tar.gz

# 游戏资源与第三方分析文档（版权敏感，仅本地参考）
iOS/docs/LawnStrings-*.json

# ---- 交接文档（时效性强，随 zip 传递，不入库）----
# 这类文档包含具体提交号、日期、分支状态等易过期信息，
# 放在 git 里会随提交推进不断失真，改由交接包传递。
docs/双端代码同步流程.md
